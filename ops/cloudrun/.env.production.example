# Production fill-in template for Cloud Run + Secret Manager + GitHub + Vercel.
# Copy to .env.production (gitignored) and fill the right-hand values.
# Never commit the filled file. Cloud Run does not read this file at runtime;
# you paste each value into Google Secret Manager, GitHub Actions variables, or Vercel.

# =============================================================================
# A) Google Cloud project (non-secret)
# Paste into GitHub → Settings → Secrets and variables → Actions → Variables
# =============================================================================
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCP_ARTIFACT_REPOSITORY=fresherai
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_DEPLOY_SERVICE_ACCOUNT=
GCP_RUNTIME_SERVICE_ACCOUNT=
GCP_SCHEDULER_SERVICE_ACCOUNT=
GCP_BILLING_BUDGET_READY=false
GCP_CLOUD_RUN_DEPLOY=false

# =============================================================================
# B) Google Secret Manager (secrets — never GitHub, never the repo)
# Create a secret with the LEFT name, paste the RIGHT value as the secret payload.
# =============================================================================
MONGODB_URL=
REDIS_URL=
GROQ_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=

# =============================================================================
# C) More GitHub Actions variables (non-secret)
# =============================================================================
FIREBASE_PROJECT_ID=
FRONTEND_URL=
GROQ_MODEL=qwen/qwen3.8-27b
EMAIL_PROVIDER=none
EMAIL_FROM=

# =============================================================================
# D) Vercel frontend (Project → Settings → Environment Variables)
# After the first Cloud Run deploy, set VITE_BACKEND_URL to the printed gateway URL.
# =============================================================================
VITE_BACKEND_URL=
VITE_FIREBASE_APIKEY=
VITE_FIREBASE_AUTHDOMAIN=
VITE_FIREBASE_PROJECTID=
VITE_FIREBASE_STORAGEBUCKET=
VITE_FIREBASE_MESSAGINGSENDERID=
VITE_FIREBASE_APPID=
VITE_FIREBASE_MEASUREMENTID=
VITE_RAZORPAY_KEY_ID=
