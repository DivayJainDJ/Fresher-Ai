NODE_ENV=production
PORT=6004
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/dbname
REDIS_URL=redis://default:password@host:6379
GROQ_API_KEY=
YOUTUBE_API_KEY=

# Optional free fallback providers — used automatically if the
# primary Groq call is rate-limited (429). Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
ROADMAP_CONSUMER_NAME=roadmap-worker
EVENT_MAX_ATTEMPTS=5
